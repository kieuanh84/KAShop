@model IEnumerable<TrangWebBanHang.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="mb-4 text-center">
        <h2 class="fw-bold display-6"><i class="bi bi-receipt-cutoff text-warning me-2"></i>DANH SÁCH ĐƠN HÀNG</h2>
        <div class="badge bg-dark px-4 py-2 mt-2">Tổng doanh thu: @Model.Sum(x => x.TotalAmount).ToString("#,##0") đ</div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card border-0 shadow-sm h-100 position-relative overflow-hidden" style="border-radius: 15px;">
                    <div class="position-absolute start-0 top-0 bottom-0 bg-success" style="width: 6px;"></div>

                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="fw-bold text-primary mb-0">Đơn hàng #@item.Id</h5>
                            <span class="badge bg-success-subtle text-success px-3">Mới</span>
                        </div>

                        <div class="mb-2">
                            <i class="bi bi-person me-2"></i><strong>@item.FullName</strong>
                        </div>
                        <div class="mb-2 text-muted small">
                            <i class="bi bi-calendar3 me-2"></i>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                        </div>
                        <div class="mb-3 text-muted small">
                            <i class="bi bi-geo-alt me-2"></i>@item.Address
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <div>
                                <small class="text-muted d-block">Tổng cộng:</small>
                                <span class="fw-bold text-danger fs-4">@item.TotalAmount.ToString("#,##0") đ</span>
                            </div>
                            <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-dark rounded-pill px-4 shadow-sm">Chi tiết</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>