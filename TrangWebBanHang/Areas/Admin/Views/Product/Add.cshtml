@model TrangWebBanHang.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card border-0 shadow">
        <div class="card-header text-white text-center" style="background-color: #ff5722;">
            <h4 class="mb-0">Thêm sản phẩm mới</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Add" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Giá bán</label>
                        <input asp-for="Price" type="number" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryId" class="form-label fw-bold">Danh mục</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label fw-bold">Đường dẫn ảnh (URL)</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">Lưu sản phẩm</button>
                    <a asp-action="Index" class="btn btn-light px-4 border">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>