@model IEnumerable<TrangWebBanHang.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary fw-bold"><i class="bi bi-cart-fill"></i> Giỏ Hàng Của Bạn</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning border-0 shadow-sm text-center py-5">
            <h4>Giỏ hàng của bạn đang trống!</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="card shadow border-0">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Thành tiền</th>
                            <th class="text-center pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 d-flex align-items-center">
                                    <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 50px; height: 50px; object-fit: cover; margin-right: 15px; border-radius: 5px;" />
                                    <span class="fw-bold">@item.ProductName</span>
                                </td>
                                <td>@item.Price.ToString("#,##0") đ</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end fw-bold">@((item.Price * item.Quantity).ToString("#,##0")) đ</td>
                                <td class="text-center pe-4">
                                    <a asp-action="RemoveFromCart" asp-route-productId="@item.ProductId" class="btn btn-outline-danger btn-sm">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold fs-5">TỔNG CỘNG:</td>
                            <td class="text-end fw-bold text-danger fs-5">
                                @Model.Sum(x => x.Price * x.Quantity).ToString("#,##0") đ
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4 mb-5">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">Mua tiếp</a>
            <a asp-action="Checkout" class="btn btn-success px-5 fw-bold shadow">THANH TOÁN</a>
        </div>
    }
</div>