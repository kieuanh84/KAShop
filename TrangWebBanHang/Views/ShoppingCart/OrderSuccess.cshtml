@model int
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container mt-5 text-center">
    <div class="card shadow border-0 py-5">
        <div class="card-body">
            <h1 class="display-1 text-success">✔️</h1>
            <h2 class="fw-bold">ĐẶT HÀNG THÀNH CÔNG!</h2>
            <p class="text-muted fs-5">Cảm ơn bạn đã mua sắm. Mã đơn hàng của bạn là: <strong>#@Model</strong></p>
            <p>Chúng tôi sẽ sớm liên hệ với bạn để xác nhận đơn hàng.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-5 mt-3 rounded-pill">
                QUAY LẠI TRANG CHỦ
            </a>
        </div>
    </div>
</div>